[application]

config/name="Mini Jump"
config/icon="res://icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward+")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/resizable=false
window/size/fullscreen_mode=0
window/size/always_on_top=false
window/mouse/emulate_touch_from_mouse=true
window/mouse/emulate_mouse_from_touch=false

[rendering]

rendering/quality/depth/prepass/enable=false
rendering/environment/defaults/default_clear_color=Color(0.12, 0.12, 0.14, 1)

[input]

./tap = {
"deadzone": 0.5,
"events": [
{
"type": "InputEventScreenTouch",
"index": 0
}
]
}

[physics]

physics/common/physics_ticks_per_second=60

[autoload]

GameManager="res://scripts/game_manager.gd"
AudioManager="res://scripts/audio_manager.gd"

[editor]

interface/editor/primary_theme="res://theme/theme.tres"

[debug]

settings/gdscript/warnings/enable_unsafe_property_access=false
settings/gdscript/warnings/enable_unsafe_method_access=false