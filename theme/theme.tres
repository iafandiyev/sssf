[gd_resource type="Theme" load_steps=1 format=3 uid="//uid/theme1"]

[resource]
default_font = SubResource("1_font")
default_font_size = 18

[font]
default_font = SubResource("1_font")

[font "1_font"]
type = "DynamicFont"
data = SubResource("1_font_data")

[font "1_font_data"]
type = "DynamicFontData"
font_data = ExtResource("1_font_file")

[ext_resource type="File" path="res://theme/fonts/Inter-Regular.ttf" id="1_font_file"]

[style "Label:Title"]
type = "StyleBoxEmpty"
font_color = Color(0.98, 0.95, 0.9, 1)
font_outline_color = Color(0.1, 0.1, 0.12, 1)
font_outline_size = 2

